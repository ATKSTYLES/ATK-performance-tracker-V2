# ATK Deck V2 — Portable Self-Hosted Configuration
# Copy this file to .env and customize for your local computer or server.

# HTTP port the unified Express + frontend server listens on
PORT=3000

# Runtime environment: uncomment NODE_ENV=production when running built production deployments
# NODE_ENV=production

# Persistent directory holding the SQLite database (atk-deck.db) and uploaded screenshots (uploads/)
# Mount this directory as a persistent volume in Docker or VPS deployments.
DATA_DIR=./data

# Optional explicit overrides (defaults derive from DATA_DIR)
# DB_PATH=./data/atk-deck.db
# UPLOADS_DIR=./data/uploads

# Single-user security lock: keep false so only the first-run owner account can be registered.
ALLOW_PUBLIC_REGISTRATION=false

# Session cookie lifetime in days
SESSION_TTL_DAYS=14

# Cookie security mode:
#   true  — production default (enforces Secure cookies over HTTPS; local plain-HTTP dev automatically falls back to false)
#   false — force non-secure cookies (only for local HTTP-only testing)
#   auto  — derive from HTTPS / X-Forwarded-Proto header
COOKIE_SECURE=true

# Optional future PostgreSQL connection string (SQLite is used by default)
# DATABASE_URL=postgres://user:password@localhost:5432/atk_deck
